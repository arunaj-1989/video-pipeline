UVM_ENVIRONMENT=development
UVM_LOG_LEVEL=INFO
UVM_API_PREFIX=/api/v1
UVM_DATABASE_URL=postgresql+psycopg://uvm_user@localhost:5432/universal_video_maker
UVM_CHROMA_PERSIST_DIRECTORY=data/chroma
UVM_CHROMA_COLLECTION=universal_video_knowledge
UVM_SOURCE_SNAPSHOT_DIRECTORY=data/source-snapshots
UVM_TAVILY_API_KEY=
UVM_TAVILY_API_BASE_URL=https://api.tavily.com
UVM_TAVILY_REQUEST_TIMEOUT_SECONDS=30
UVM_TAVILY_MAX_RESULTS=6
UVM_OLLAMA_BASE_URL=http://localhost:11434
UVM_OLLAMA_CHAT_MODEL=qwen2.5:7b
UVM_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
UVM_OLLAMA_REQUEST_TIMEOUT_SECONDS=600
UVM_OIDC_ISSUER_URL=http://localhost:8080/realms/universal-video-maker
UVM_OIDC_JWKS_URL=http://localhost:8080/realms/universal-video-maker/protocol/openid-connect/certs
UVM_OIDC_AUDIENCE=universal-video-maker-api
UVM_MINIO_ENDPOINT_URL=http://localhost:9000
UVM_MINIO_ACCESS_KEY=
UVM_MINIO_SECRET_KEY=
UVM_MINIO_BUCKET=universal-video-assets
UVM_MINIO_REGION=us-east-1
UVM_KEYCLOAK_BOOTSTRAP_ADMIN=
UVM_KEYCLOAK_BOOTSTRAP_PASSWORD=
UVM_RUNPOD_API_KEY=
UVM_RUNPOD_SERVERLESS_ENDPOINT_ID=
# Optional: render on a RunPod Pod instead (takes priority over Serverless).
# Written by scripts/pod.ps1 -Action Create. RUNPOD_MANAGE_KEY needs Pod access.
UVM_RUNPOD_POD_URL=
UVM_RUNPOD_POD_API_KEY=
UVM_RUNPOD_API_BASE_URL=https://api.runpod.io/v2
UVM_RUNPOD_REQUEST_TIMEOUT_SECONDS=30
UVM_RUNPOD_MAX_JOB_COST_USD=25.00
UVM_RUNPOD_MONTHLY_BUDGET_USD=250.00
